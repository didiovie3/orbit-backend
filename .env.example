# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real keys.

ENV=dev

# Supabase → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Supabase → Settings → API → JWT Settings → JWT Secret
# Used to verify tokens the Android app sends in the Authorization header.
SUPABASE_JWT_SECRET=your-jwt-secret-here

# Google Cloud OAuth client (Calendar + Drive combined scope)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Google AI Studio / Genkit
GEMINI_API_KEY=your-gemini-api-key

# Firebase Cloud Messaging — service account JSON path (for sending pushes)
FCM_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
