# ═══════════════════════════════════════════════════════════════════════════
# ORBIT BACKEND — Environment variables
#
# Copy this file to .env and fill in every value below.
# .env is gitignored — never commit it. This file (.env.example) IS
# committed, so keep it accurate but keep real secrets out of it.
#
# Order below matches the pre-build checklist: Supabase → Google Cloud →
# Gemini → Firebase. Do them in that order — each one unlocks the next.
# ═══════════════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────────────────
# 1. SUPABASE
# supabase.com → your project
# ─────────────────────────────────────────────────────────────────────────

# Settings → API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Settings → API → Project API keys → service_role (click "Reveal")
# ⚠️ This key bypasses Row Level Security. Backend only — never send this
# to the Android app, never put it in a git commit, never log it.
SUPABASE_SERVICE_KEY=

# Settings → API → JWT Settings → JWT Secret (click "Reveal")
# Used to verify the tokens Android sends in the Authorization header.
SUPABASE_JWT_SECRET=

# Settings → API → Project API keys → anon / public
# Not used by the backend code today (Kotlin uses this one, not Python) —
# kept here so the whole Supabase key set lives in one place for reference.
SUPABASE_ANON_KEY=


# ─────────────────────────────────────────────────────────────────────────
# 2. GOOGLE CLOUD — OAuth (Calendar + Drive combined scope)
# console.cloud.google.com → your project → APIs & Services → Credentials
# ─────────────────────────────────────────────────────────────────────────

# Credentials → OAuth 2.0 Client IDs → your client → Client ID
GOOGLE_CLIENT_ID=

# Same screen → Client secret
GOOGLE_CLIENT_SECRET=

# The redirect URI you registered for this client (Authorized redirect URIs).
# Must match EXACTLY what's typed into Google Cloud Console, including
# trailing slashes. This is what Supabase's Google provider screen gave you
# when you set up the provider — same URI goes in both places.
GOOGLE_REDIRECT_URI=


# ─────────────────────────────────────────────────────────────────────────
# 3. GEMINI / GENKIT
# aistudio.google.com → Get API key  (or via the same Google Cloud project)
# ─────────────────────────────────────────────────────────────────────────

GEMINI_API_KEY=


# ─────────────────────────────────────────────────────────────────────────
# 4. FIREBASE — Cloud Messaging (push notifications only, not DB/auth)
# console.firebase.google.com → your project → Project settings
# ─────────────────────────────────────────────────────────────────────────

# Project settings → Service accounts → Generate new private key.
# This downloads a JSON file — save it in the backend repo root (it's
# gitignored already) and point this at wherever you put it.
FCM_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Project settings → General → Project ID
FCM_PROJECT_ID=


# ─────────────────────────────────────────────────────────────────────────
# 5. APP SETTINGS
# Not from any console — these are yours to set.
# ─────────────────────────────────────────────────────────────────────────

# dev | staging | prod — controls which config profile loads
ENV=dev
